# 이 파일을 복사해서 같은 폴더에 .env 로 저장한 뒤 값을 채우세요.
# .env 는 .gitignore 에 들어 있어서 깃허브에 올라가지 않습니다. 비밀번호는 카톡 등으로 따로 공유하세요.
#
# Supabase > Project Settings > Database > Connection string > JDBC 에서 확인
# (무료 플랜은 "Session pooler" 주소 권장)
DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.프로젝트ID
DB_PASSWORD=여기에_DB_비밀번호

SHOW_SQL=true

# 프로필 사진 저장소 (Supabase > Project Settings > API Keys)
# SUPABASE_SERVICE_KEY 는 Legacy 탭의 service_role 키 (모든 권한! 절대 공개 금지)
SUPABASE_URL=https://프로젝트ID.supabase.co
SUPABASE_SERVICE_KEY=여기에_service_role_키
SUPABASE_BUCKET=profile-photos
